<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B140D"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- POH Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#2E2218"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏡 "
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_poh_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="POH Estate"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_poh_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏡 POH Open"
            android:textColor="#52B788"
            android:textStyle="bold"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Pet Details Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_pet_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐉"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/widget_pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baby Black Dragon"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_pet_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍗 Hunger: 85%  •  💖 Happy: 90%"
                android:textColor="#F5EBE0"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_pet_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#38291B"
        android:padding="4dp"
        android:text="&quot;Welcome to your Player Owned House!&quot;"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="italic" />

</LinearLayout>
